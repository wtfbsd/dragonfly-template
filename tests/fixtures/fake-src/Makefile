# The test suite cannot build a world, so it points build.sh at a fake
# source tree whose Makefile only declares the targets the build calls.
# The stand-in for make(1) in tests/stubs honours them.

buildworld:
	@echo "buildworld"

buildkernel:
	@echo "buildkernel"
