#!/bin/sh
#
# tests/stubs/passwd — a stand-in for passwd(8) used by the test suite.
#
# Copyright (c) 2026 The wtfbsd contributors. BSD-2-Clause (see LICENSE).
#
# It only records the call in $STUB_LOG: the test asserts that the build
# locks the root password in the master password file of the release root
# and rebuilds the password database from it, instead of asking passwd(8)
# to do it (passwd(8) has no -R on the BSDs and -l does not lock an
# account there).

set -eu

: "${STUB_LOG:=/dev/null}"
printf 'CMD passwd %s\n' "$*" >> "$STUB_LOG"

exit 0
